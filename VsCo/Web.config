<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- سلسلة الاتصال بقاعدة بيانات PostgreSQL -->
    <!-- عدّل Host و Username و Password بما يناسب تثبيت PostgreSQL لديك -->
    <add name="VsCoDb"
         connectionString="Host=localhost;Port=5432;Database=vsco_db;Username=postgres;Password=postgres" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" strict="false" explicit="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <!-- أثناء التعلم: إظهار رسائل الخطأ التفصيلية بدلاً من صفحة خطأ عامة -->
    <customErrors mode="Off" />
    <globalization culture="auto" uiCulture="auto" />
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Npgsql" publicKeyToken="5d8b90d52f46fda7" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
